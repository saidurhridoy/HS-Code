# ============================================================================
# DutyLens BD — Environment Configuration Template
# Copy to `.env` for local, Docker, Render, Railway, Fly.io, or VPS deployment.
# Leave SUPABASE_* blank to run in zero-dependency local in-memory mode.
# ============================================================================

PORT=3000
NODE_ENV=production

# Optional Supabase Cloud PostgreSQL Connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# HMAC Secret for Signing User Session Bearer Tokens (32+ random characters)
AUTH_TOKEN_SECRET=replace-with-a-strong-32-byte-random-secret
